# Local development defaults. This file holds key NAMES and safe local
# defaults only, never real secrets (INV-3). Copy to .env to use; .env is
# git-ignored. Production secrets live only in the production .env.

DATABASE_URL=sqlite:////home/<you>/tres-comas-data/tres_comas.db
TZ=America/Toronto

# Session cookie Secure flag off: local http dev only. Never 0 in production.
TRES_COMAS_COOKIE_SECURE=0
# Generate with `python hash_password.py`; without it, login answers 503.
# TRES_COMAS_PASSWORD_HASH=
