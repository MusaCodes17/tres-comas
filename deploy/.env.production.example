# Tres Comas production .env template. KEY NAMES ONLY.
#
# On the box: copy this file to /opt/tres-comas/.env, fill the values by hand,
# and never commit the result (INV-3). Secrets live only in that production
# .env. No client, Claude included, ever receives one.
#
# Bank of Canada Valet (FX) needs no key (D-13).

# Host directory for the SQLite database (local disk only). Default: ~/tres-comas-data
TRES_COMAS_DATA_DIR=
TZ=America/Toronto

# T4: single-user login
# TRES_COMAS_LOGIN_PASSWORD=
# TRES_COMAS_SESSION_SECRET=

# D-14 / T7: price provider key name, decided by the spike
# (provider key name not yet decided)

# D-4: LLM analysis key
# ANTHROPIC_API_KEY=
